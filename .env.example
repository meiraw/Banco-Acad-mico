# Copie para .env na raiz. Execute o backend a partir da raiz do projeto.
# Use valores sem aspas; este arquivo também é lido como Java Properties.
POSTGRES_PASSWORD=
# Opcional: DB_PASSWORD substitui POSTGRES_PASSWORD no backend.
# JWT_SECRET: preencha com um segredo aleatório de pelo menos 32 caracteres.
JWT_SECRET=

# Conta autorizada a enviar mensagens. Para Gmail, use uma senha de aplicativo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

PASSWORD_RESET_URL=http://localhost:5173/redefinir-senha
EMAIL_CONFIRMATION_URL=http://localhost:5173/confirmar-email
CORS_ALLOWED_ORIGINS=http://localhost:5173
