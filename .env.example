
POSTGRES_PASSWORD=
MODERATION_ADMIN_EMAIL=
JWT_SECRET=

# Conta autorizada a enviar mensagens. Para Gmail, use uma senha de aplicativo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

PASSWORD_RESET_URL=http://localhost:5173/redefinir-senha
EMAIL_CONFIRMATION_URL=http://localhost:5173/confirmar-email
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Ative ao disponibilizar uma instância ClamAV na rede privada.
UPLOAD_ANTIMALWARE_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
UPLOAD_ROOT=Uploads
# Diretórios antigos exatos, separados por ; (somente ao importar dados).
UPLOAD_LEGACY_ROOTS=
UPLOAD_USER_QUOTA_BYTES=524288000
UPLOAD_DISK_RESERVE_BYTES=104857600
UPLOAD_CONCURRENCY=2
UPLOAD_ATTEMPTS_15MIN=20
UPLOAD_BYTES_15MIN=104857600
